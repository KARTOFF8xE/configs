alias g='git'
alias ga='g add'
alias gaa='g add --all'
alias gb='g branch'
alias gba='g branch --all'
alias gbd='g branch --delete'
alias gbm='g branch --move'
alias gs='g switch'
alias gsc='gs -c'
alias gsm='gs develop 2> /dev/null || gs master 2> /dev/null || gs main 2> /dev/null || echo "no matching <default>-branch found"'
alias gs-='gs -'
alias gc='g clone'
alias gcam='g commit --all --message'
alias gcm='g commit --message'
alias gcp='g cherry-pick'
alias gcaane='g commit -a --amend --no-edit'
alias gcane='g commit --amend --no-edit'
alias glg='g log --graph'
alias gl='g pull'
alias gp='g push'
alias gpf='g push --force-with-lease'
alias gpf!='g push --force'
alias gpu='g push -u origin'
alias grb='g rebase'
alias grfl='g reflog'
alias gr='g reset'
alias grh='g reset --hard'
alias grm='g reset --mixed'
alias grs='g reset --soft'
alias gsu='g stash -u'
alias gsl='g stash list'
alias gsd='g stash drop'
alias gsp='g stash pop'
alias gst='g status'
alias gss='g status --short'
